# Create a Telegram bot with @BotFather and set its username below (without @)
TELEGRAM_BOT_USERNAME=YOUR_TELEGRAM_BOT_USERNAME
TELEGRAM_BOT_TOKEN=PASTE_BOTFATHER_TOKEN_HERE

# Use a long random secret (at least 32 characters)
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Google Gemini API key from Google AI Studio. Keep this on the server only.
GEMINI_API_KEY=PASTE_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated Telegram numeric user IDs allowed to use the Admin panel
ADMIN_TELEGRAM_IDS=
PORT=3000
NODE_ENV=development
